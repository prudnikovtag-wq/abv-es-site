# Редирект с http на https создан автоматически при заказе бесплатного ssl-сертификата
RewriteEngine On
RewriteCond %{SERVER_PORT} !^443$
RewriteRule .* https://%{SERVER_NAME}%{REQUEST_URI} [R=301,L]
# Конец редиректа

# Товар 1SDA059645R1 снят с продажи (2026-10-19) -> каталог
RewriteRule ^(sklad/)?(tovar-)?1SDA059645R1\.html$ /sklad.html [R=301,L]
# Товары 1SCA112710R1001 и 1SDA038324R1 сняты с продажи (остатки на 2026-10-02) -> каталог
RewriteRule ^(sklad/)?(tovar-)?1SCA112710R1001\.html$ /sklad.html [R=301,L]
RewriteRule ^(sklad/)?(tovar-)?1SDA038324R1\.html$ /sklad.html [R=301,L]
# Промо-страница /promo/ удалена (2026-10-19): /promo, /promo/ и всё внутри -> главная
RewriteRule ^promo(/.*)?$ / [R=301,L]

# Склад из админки (2026-10): каталог, карточки, фид и sitemap собирает magazin.php из данных admin-data/.
# Аварийно отключить — поставить # в начале 4 строк RewriteRule ниже: снова заработают обычные файлы из репозитория.
RewriteRule ^sklad\.html$ /magazin.php?r=sklad [L]
RewriteRule ^tovar-([0-9A-Z][0-9A-Z-]*)\.html$ /magazin.php?r=tovar&sku=$1 [L]
RewriteRule ^feed\.xml$ /magazin.php?r=feed [L]
RewriteRule ^sitemap\.xml$ /magazin.php?r=sitemap [L]
# Конец блока склада из админки

# Старые адреса карточек товаров -> tovar-<артикул>.html
# Раньше в корне лежали страницы /<артикул>.html, а в их canonical стояли адреса /sklad/<артикул>.html.
# Эти страницы удалены, рабочие карточки — /tovar-<артикул>.html.
# Артикул: начинается с цифры, дальше только A-Z и цифры — обычные страницы сайта начинаются с букв и не затрагиваются.
# Переадресуем только если такая карточка есть (в RewriteCond $1 — артикул из следующей RewriteRule).
RewriteCond %{DOCUMENT_ROOT}/tovar-$1.html -f
RewriteRule ^([0-9][A-Z0-9]+)\.html$ /tovar-$1.html [R=301,L]
RewriteCond %{DOCUMENT_ROOT}/tovar-$1.html -f
RewriteRule ^sklad/([0-9][A-Z0-9]+)\.html$ /tovar-$1.html [R=301,L]
# Конец переадресации старых карточек

